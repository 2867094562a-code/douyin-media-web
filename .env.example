# Copy to .env; never commit a real .env file.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# For GitHub Pages use exactly the origin, WITHOUT /repository-name:
# CORS_ORIGINS=["https://YOUR_ACCOUNT.github.io"]
API_KEY=
PORT=8000
# Public system DNS is the default. For TUN Fake-IP use a fixed trusted DoH resolver.
# DNS_RESOLVER=cloudflare or alidns (queries public domain names to that provider)
DNS_RESOLVER=system
# Local macOS can use installed Chrome. Leave empty/omit in Docker.
# CHROMIUM_CHANNEL=chrome
MAX_CONCURRENT_PARSES=1
MAX_CONCURRENT_DOWNLOADS=1
MAX_BATCH_URLS=10
MAX_IN_MEMORY_JOBS=30
MAX_SINGLE_FILE_BYTES=157286400
MAX_TASK_TOTAL_BYTES=419430400
JOB_TTL_SECONDS=1800
